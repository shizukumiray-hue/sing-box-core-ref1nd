{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "ss-onering",
      "server": "your-server.com",
      "server_port": 443,
      "method": "aes-256-gcm",
      "password": "your-password-here",
      "plugin": "v2ray-plugin",
      "plugin_opts": "tls;host=your-server.com;path=/ss",
      "tls": {
        "enabled": true,
        "server_name": "onering:your-server.com:fastly.com",
        "insecure": false
      },
      "transport": {
        "type": "ws",
        "path": "/ss"
      }
    }
  ]
}
