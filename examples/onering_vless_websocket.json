{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-onering",
      "server": "your-server.com",
      "server_port": 443,
      "uuid": "your-uuid-here",
      "flow": "",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "server_name": "onering:your-server.com:zoom.us",
        "insecure": false,
        "alpn": ["h2", "http/1.1"]
      },
      "transport": {
        "type": "ws",
        "path": "/vless",
        "headers": {
          "Host": "your-server.com"
        }
      }
    }
  ]
}
